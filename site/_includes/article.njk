---
layout: base.njk
ogType: article
---
{% from "macros.njk" import card %}
{% set tagPageSlugs = [] %}
{% for t in collections.tagPages %}{% set tagPageSlugs = (tagPageSlugs.push(t.tag), tagPageSlugs) %}{% endfor %}

<article class="wrap article">

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">RecurForge</a>
    <span aria-hidden="true">/</span>
    <a href="/blog/">Blog</a>
    <span aria-hidden="true">/</span>
    <a href="/blog/{{ category }}/">{{ category | categoryTitle }}</a>
  </nav>

  <h1>{{ title }}</h1>

  <p class="article-meta">
    <time datetime="{{ date | isoDate }}">{{ date | humanDate }}</time>
    <span aria-hidden="true">·</span>
    <span>{{ content | readingTime }} min read</span>
    <span aria-hidden="true">·</span>
    <a href="/blog/{{ category }}/">{{ category | categoryTitle }}</a>
    {% if updated %}<span aria-hidden="true">·</span><span>updated {{ updated | humanDate }}</span>{% endif %}
  </p>

  <div class="prose">
    {{ content | safe }}
  </div>

  <ul class="tag-row" aria-label="Tags">
    {% for tag in tags %}
      {% if tag in tagPageSlugs %}
        <li><a href="/blog/tag/{{ tag }}/">{{ tag | tagLabel }}</a></li>
      {% else %}
        <li><span>{{ tag | tagLabel }}</span></li>
      {% endif %}
    {% endfor %}
  </ul>

  {% set shareUrl = site.url + page.url %}
  <div class="share">
    <div class="who-label">Share this article</div>
    <div class="share-row">
      <a class="social" href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a class="social" href="https://x.com/intent/post?url={{ shareUrl | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 3h5l13 18h-5zM19.2 3h2L4.8 21h-2z"/>
        </svg>
      </a>
      <a class="social" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M24 12A12 12 0 1 0 0 12a12 12 0 1 0 24 0zM10 23.8v-8.3H7.5v-3H10V9.5c0-2.6 1.5-4 3.9-4 1.1 0 2.1.1 2.6.2v2.6H15c-1.1 0-1.5.5-1.5 1.5v2.7h2.9l-.4 3h-2.5v8.3z"/>
        </svg>
      </a>
      <button class="social copy-link" type="button" data-url="{{ shareUrl }}" aria-label="Copy link">
        <svg class="icon-copy" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M11 8h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-8a3 3 0 0 1-3-3v-8a3 3 0 0 1 3-3zm0 2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1z"/>
          <path d="M5 2h8a3 3 0 0 1 3 3v1h-2V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h1v2H5a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3z"/>
        </svg>
        <svg class="icon-done" width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="author-box">
    <div class="byline">
      <span class="byname">{{ author.name }}</span>
      <a class="social" href="{{ author.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ author.name }} on LinkedIn">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      </a>
    </div>
    <p class="bio">{{ author.line }}</p>
  </div>

  {% include "signup.njk" %}

  {% set relatedPosts = collections.posts | related({ slug: slug, category: category, tags: tags }) %}
  {% if relatedPosts.length %}
  <section class="related">
    <h2>Read next</h2>
    <ul class="cards">
      {% for post in relatedPosts %}{{ card(post) }}{% endfor %}
    </ul>
  </section>
  {% endif %}

</article>
