{
  "name": "recurforge-site",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site and blog for recurforge.com",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node build/clean.mjs && node build/og.mjs && eleventy && node build/verify-homepage.mjs",
    "start": "node build/clean.mjs && eleventy --serve",
    "check": "node build/validate.mjs",
    "list": "node build/list.mjs",
    "og": "node build/og.mjs",
    "verify": "node build/verify-homepage.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "fontkit": "^2.0.4",
    "gray-matter": "^4.0.3",
    "wawoff2": "^2.0.1"
  }
}
