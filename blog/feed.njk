---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.name }} blog</title>
    <link>{{ site.url }}/blog/</link>
    <description>{{ site.blog.description }}</description>
    <language>en</language>
    <atom:link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/rss+xml"/>
    {%- if collections.posts.length %}
    <lastBuildDate>{{ collections.posts[0].data.date | rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title | xml }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.data.date | rfc822 }}</pubDate>
      <description>{{ post.data.description | xml }}</description>
      <category>{{ post.data.category | categoryTitle | xml }}</category>
      {%- for tag in post.data.tags %}
      <category>{{ tag | tagLabel | xml }}</category>
      {%- endfor %}
      <content:encoded><![CDATA[{{ post.templateContent | absoluteUrls | safe }}]]></content:encoded>
    </item>
    {%- endfor %}
  </channel>
</rss>
