<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ metaTitle if metaTitle else title + " — RecurForge" }}</title>
<meta name="description" content="{{ metaDescription if metaDescription else (description if description else site.blog.description) }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}

<meta property="og:type" content="{{ ogType if ogType else 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ ogTitle if ogTitle else title }}">
<meta property="og:description" content="{{ metaDescription if metaDescription else (description if description else site.blog.description) }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage if ogImage else '/og.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogTitle if ogTitle else title }} — RecurForge">
<meta property="og:site_name" content="RecurForge">
{% if ogType == "article" %}<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:modified_time" content="{{ lastmod | isoDate }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage if ogImage else '/og.png' }}">

<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta id="theme-color" name="theme-color" content="#FFFFFF">
<link rel="alternate" type="application/rss+xml" title="RecurForge blog" href="{{ site.url }}/blog/feed.xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chivo:wght@400;700;800&family=IBM+Plex+Mono:wght@400&display=swap">
<link rel="stylesheet" href="/assets/blog/blog.css">

{% if structuredData %}{% for block in structuredData %}
<script type="application/ld+json">{{ block | dump(2) | safe }}</script>
{% endfor %}{% endif %}

<script>
  /* Ставимо тему до першого малювання, щоб не блимало світлим перед темним.
     Той самий ключ і та сама логіка, що на головній. */
  (function () {
    try {
      var saved = localStorage.getItem('rf-theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    } catch (e) { /* приватний режим — просто йдемо за системною темою */ }
  })();
</script>
</head>
<body>

<header>
  <div class="wrap bar">
    <a class="lockup" href="/" aria-label="RecurForge home">
      <svg class="mark" width="30" height="30" viewBox="0 0 64 64" fill="none" role="img" aria-label="RecurForge">
        <mask id="linkcut" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
          <rect width="64" height="64" fill="#fff"/>
          <rect x="25" y="10" width="30" height="30" rx="11" fill="none" stroke="#000" stroke-width="11"/>
        </mask>
        <rect class="link-a" x="9" y="24" width="30" height="30" rx="11" fill="none" stroke="#14161A" stroke-width="5" mask="url(#linkcut)"/>
        <rect class="link-b" x="25" y="10" width="30" height="30" rx="11" fill="none" stroke="#A8481A" stroke-width="5"/>
      </svg>
      <div class="name">Recur<span>Forge</span></div>
    </a>

    <div class="bar-right">
      <a class="nav-link" href="/blog/">Blog</a>
      <button class="theme-toggle" type="button" id="themeToggle" aria-label="Switch theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="who-label">Who is building it</div>
    <div class="byline">
      <span class="byname">{{ authors[site.defaultAuthor].name }}</span>
      <a class="social" href="{{ authors[site.defaultAuthor].linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="{{ authors[site.defaultAuthor].name }} on LinkedIn">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
    <p class="bio">{{ authors[site.defaultAuthor].line }}</p>
    <p class="foot-links"><a href="/">Home</a> · <a href="/blog/">Blog</a> · <a href="/blog/feed.xml">RSS</a></p>
  </div>
</footer>

<script src="/assets/blog/blog.js"></script>
</body>
</html>
